# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/

# Data - broad ignores first, specific negations below (Edge parity)
*.csv
*.csv.gz
*.duckdb
*.duckdb.wal
*.parquet

# Local/env
.env
localdata/*
*.log
*.zip
.env.*
!.env.example
data/raw/
data/cache/

# OS/editor
.DS_Store
.vscode/
.idea/

# --- Negations: small regenerated artifacts that ARE committed -----------------
# These survive GitHub Actions cache eviction so CI certifies autonomously
# WITHOUT any local machine in the loop (Edge-Factory parity).
# Picks / audit / forecast / tickets
!localdata/picks_*.json
!localdata/picks_*.txt
!localdata/picks_today.json
!localdata/picks_morning_*.json
!localdata/picks_next_*.json
!localdata/picks_forecast_*.json
!localdata/picks_forecast_*.txt
!localdata/picks_audit_*.json
!localdata/picks_audit_*.md
!localdata/picks_audit_forecast_*.json
!localdata/picks_audit_forecast_*.md
!localdata/picks_audit_rolling.json
!localdata/picks_audit_forecast_rolling.json
!localdata/whatsapp_sent_ledger_*.json
!localdata/edges_*.txt
!localdata/edges_*.json
!localdata/auto_tickets_*.json
!localdata/auto_tickets_*.txt
!localdata/auto_tickets_*.log
!localdata/auto_tickets_grade.log
!localdata/auto_tickets_grade_*.log
!localdata/auto_tickets_state.json
!localdata/auto_tickets_performance.json
!localdata/auto_tickets_today.json
!localdata/auto_tickets_today.txt
!localdata/clv_*.json
!localdata/clv_*.md
!localdata/.keepalive

# Core history for autonomous certification (Edge parity)
# These are immutable or slowly growing, committed so warehouse can rebuild after cache eviction
!localdata/tennisdata_*.csv.gz
!localdata/oddsportal_*.csv.gz
!localdata/predictions_*.csv.gz
!localdata/theoddsapi_*.csv.gz
!localdata/betexplorer_*.csv.gz
!localdata/forebet.csv.gz
!localdata/foretennis.csv.gz
!localdata/forebet_results_*.csv.gz
!localdata/foretennis_results_*.csv.gz
!localdata/challenger_results_*.csv.gz
!localdata/settled_results.json
!localdata/pipeline_health.json
!localdata/auto_tickets_state.json.*

# Stray data files accidentally created in repo root (no extension)
# Date-named files like "2026-06-14" should not be committed
/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]
